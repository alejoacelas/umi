          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/tern-hook.sh codex SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
